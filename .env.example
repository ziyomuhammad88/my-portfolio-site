# Токен бота, который выдаёт @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ Gemini API (Google AI Studio -> Get API key)
GEMINI_API_KEY=

# Твой числовой Telegram user_id (узнать можно у @userinfobot)
ADMIN_USER_ID=

# ID канала, куда публиковать посты.
# Публичный канал: @username_канала
# Приватный канал: -100XXXXXXXXXX (см. README, как узнать)
CHANNEL_ID=

# Необязательно: какую модель Gemini использовать (см. актуальный список на
# ai.google.dev/gemini-api/docs/models — на сентябрь 2026 рекомендуемая
# быстрая модель gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Необязательно: список твоих инструментов через запятую — на шаге "Инструмент"
# бот покажет их кнопками вместо ручного ввода. Если оставить пустым — бот
# попросит ввести инструмент текстом.
INSTRUMENTS=GER40,US500,US100,DXY,EURUSD,AUDUSD,USDJPY,NZDUSD,GBPUSD,XAGUSD,XAUUSD,BTCUSDT

# Необязательно: частые значения итога дня через запятую — на шаге "Итог дня"
# бот покажет их кнопками. Точную сумму всё равно можно ввести текстом, если
# её нет среди кнопок.
DAY_RESULTS=-300$,-200$,-100$,-50$,0$,+50$,+100$,+200$,+300$

# Необязательно: часовой пояс для недельных/месячных отчётов (суббота 8:00 —
# неделя, 1-е число 8:00 — месяц). Имя из базы IANA tz, см.
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
REPORT_TIMEZONE=Asia/Tashkent

# Необязательно: путь к файлу базы данных истории опубликованных сессий
# (SQLite). Если оставить пустым — используется history.db рядом с bot.py.
# Файл создаётся автоматически, в нём реальная торговая история — не
# коммитить (см. .gitignore).
DB_PATH=
